# Normalise line endings so the repo works from Windows, macOS and Linux.
* text=auto eol=lf

# Windows launchers must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary media and model files are never touched.
*.mp4 binary
*.mov binary
*.mkv binary
*.webm binary
*.mp3 binary
*.wav binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
